{
  "name": "actionledger-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auditable execution gateway for AI-agent tool actions (local engineering demonstration)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings --experimental-strip-types src/server.ts",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@playwright/test": "^1.56.1"
  },
  "license": "MIT"
}
